{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "patchNet",
  "version": "0.1.0",
  "identifier": "com.patchnet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/patchNet/",
    "beforeDevCommand": "VITE_PLATFORM=native npm run dev",
    "beforeBuildCommand": "VITE_PLATFORM=native npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "patchNet",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": null,
    "fs": null
  }
}
